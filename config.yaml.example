# Massalarme – Scale Alarm Manager
# Example configuration. Copy to ~/.config/massalarme/config.yaml

# Phone MAC address, used to find the phone on the LAN via the ARP table.
# Only needed for the legacy "pc" alarm_owner below. Leave it empty and the
# daemon does not go looking.
phone_mac: ""

# Local network CIDR (for ARP scanning)
lan_network: "192.168.1.0/24"

# HTTP port on the Android app
port: 8080

# Port for the PC HTTP+WebSocket server
pc_port: 8888

# Interval (seconds) between phone discovery scans.
# Lower = faster reconnect after phone IP change, higher = less network noise.
phone_scan_interval: 10

# Xiaomi scale BLE advertisement name
scale_name: "MIBFS"

# BLE service UUID prefix for body composition
scale_uuid_prefix: "0000181b"

# BLE flag byte indicating a reading that should stop a hard alarm.
#   0xa4 (164) - weight settled, no impedance reading (socks are fine)
#   0x26 (38)  - impedance/body-fat reading complete (needs bare feet)
# Only used when alarm_owner is "pc"; the phone chooses this in its own
# Settings screen.
syncing_weight_flag: 0xa4

# Minimum weight (kg) to accept as a valid reading. A floor to reject the cat,
# a suitcase, and the scale talking to itself.
min_weight_kg: 30

# Alarm trigger retry: first 3 attempts at this interval (seconds)
retry_fast_interval: 10

# Alarm trigger retry: after the first 3, retry every this many seconds
retry_interval: 120

# Alarm trigger retry: give up after this many failed attempts for a single alarm
max_trigger_attempts: 5

# Shared secret for authenticating requests to the phone.
# Auto-generated on first run. Scan the QR code with the phone app.
shared_secret: ""

# ── Who owns the alarm ────────────────────────────────────────────────
# "phone" (default): the app schedules alarms and listens to the scale.
#   This daemon serves the schedule and publishes weigh-ins. The alarm
#   rings even when the PC is asleep.
# "pc": legacy behaviour — this daemon scans BLE and drives the phone.
alarm_owner: phone

# Scale advertisements closer together than this are one trip to the scale.
# The scale rebroadcasts a result many times and the reading drifts while you
# settle, so they are collapsed into a single weigh-in.
weigh_in_gap_seconds: 90

# ── ontoplano ─────────────────────────────────────────────────────────
# massalarme stays the source of truth; ontoplano gets a copy for charting.
# Local data is never deleted because it was uploaded, and with sync off
# massalarme works exactly as before.
#
# The API token is NOT stored here. Run `make set-token` — it goes in
# ~/.config/massalarme/ontoplano_token with mode 0600.
ontoplano:
  enabled: false
  base_url: ""          # e.g. https://app.ontoplano.com or http://192.168.1.10:1493
  timeout_seconds: 15
  batch_size: 500

  # Derive alarms from the ontoplano planner. ontoplano reports *what is
  # scheduled*; deciding which occurrences deserve an alarm, and whether it is
  # hard or soft, is massalarme's business and lives here.
  #
  # First matching rule wins. Occurrences matching nothing get no alarm.
  # Requires the token to carry the `schedule:read` scope.
  schedule:
    enabled: false
    days: 7
    poll_minutes: 30
    rules:
      - match: {title: "(?i)wake up|acordar"}
        kind: hard      # only silenced by standing on the scale
      # - match: {category: duty}
      #   kind: soft    # dismissible with a button, softer ringtone
