# ── Personal data and live config ────────────────────────────────────
# Real weigh-ins and the live schedule. The .example files are the ones
# meant to be read; these are one person's actual data.
weights.db
alarms.yaml
alarms.json
config.yaml

# ── Raw Bluetooth captures ───────────────────────────────────────────
# `make listen` and btmon output carry the MAC address of every device
# within range, and the payloads themselves are weigh-ins. CONTRIBUTING.md
# asks people to take these; nobody should be able to commit one by accident.
btmon-*
*.btmon
capture-*
xiaomi-exploration/

# ── Editors and scratch ──────────────────────────────────────────────
nvim.log
.sisyphus/
.idea/
*.iml
.DS_Store

# ── claude-docker local state (may contain credentials) ──────────────
.claude/
.claude-docker/
.claude-docker-EMERGENCY-BACKUP-*.tar.gz

# Agent scratch space, masked from the host by a tmpfs.
.ensaboai/
