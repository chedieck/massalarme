<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Dark dialog to match the rest of the app. Without this the AlertDialog
      title and button bars inherit the light AppCompat theme and appear as
      white bands above and below dark content.
    -->
    <style name="MassalarmeDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="colorAccent">@color/secondary_accent</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/MassalarmeDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/MassalarmeDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/MassalarmeDialogButtonDestructive</item>
    </style>

    <style name="MassalarmeDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/secondary_accent</item>
    </style>

    <!-- Delete reads as destructive, so it does not sit in the same colour as Save. -->
    <style name="MassalarmeDialogButtonDestructive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/error_red</item>
    </style>


    <!-- ── Settings ──────────────────────────────────────────────────
         One card per concern, left-aligned, with a fixed rhythm: heading,
         value, caption, action. Consistency is what makes the groupings
         readable at a glance. -->

    <style name="TabIcon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">4dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/section_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="SettingsHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/secondary_accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="SettingsValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>

    <style name="SettingsInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/time_field</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="SettingsSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip_outline</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsGhostButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/button_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SettingsGhostButtonInline" parent="SettingsGhostButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">0dp</item>
    </style>

    <!--
      The clock and calendar pickers are framework dialogs, so they need an
      android:* parent rather than an AppCompat one. Without this they show up
      as a bright white panel in the middle of a dark app.
    -->
    <style name="MassalarmePicker" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/secondary_accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

</resources>
