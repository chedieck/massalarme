<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/alarm_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alarm"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step on the scale to stop the alarm"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Soft alarms: one button, done. -->
        <Button
            android:id="@+id/dismiss_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="DISMISS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@color/primary_accent"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <!-- Hard alarms: the scale, or the passphrase as the escape hatch. -->
        <TextView
            android:id="@+id/passphrase_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="…or type the passphrase"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/passphrase_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start typing..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@color/input_bg"
            android:padding="16dp"
            android:textSize="16sp"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/try_again_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRY AGAIN!"
            android:textColor="@color/error_red"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/scale_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/secondary_accent"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</FrameLayout>
