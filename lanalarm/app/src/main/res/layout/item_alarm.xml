<?xml version="1.0" encoding="utf-8"?>
<!--
  One alarm in the list: time first and large, because that is what you scan for.
  Everything else is secondary text underneath, and the switch is reachable
  without opening the editor.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:00"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/alarm_kind_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="SCALE"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="7dp" />

            <TextView
                android:id="@+id/alarm_origin_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="ONTOPLANO"
                android:textColor="@color/secondary_accent"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:visibility="gone"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="7dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/alarm_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wake up"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/alarm_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mon Wed Fri"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <Switch
        android:id="@+id/alarm_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp" />

</LinearLayout>
