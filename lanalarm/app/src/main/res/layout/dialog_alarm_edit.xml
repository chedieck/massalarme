<?xml version="1.0" encoding="utf-8"?>
<!--
  Alarm editor.

  Replaces a typed "HH:MM" field, a type spinner and seven default checkboxes
  that ran off the edge of the screen. The time opens the system clock picker,
  the days are seven equal-weight circles that always fit, and the repeat type is
  inferred from the selection rather than being a separate thing to get wrong.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Tap to open the clock picker. -->
        <TextView
            android:id="@+id/edit_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/time_field"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="07:00"
            android:textColor="@color/text_primary"
            android:textSize="52sp"
            android:letterSpacing="0.02"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tap to change"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/time_field"
            android:hint="Alarm name"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REPEAT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <!-- Seven equal-weight circles: nothing can fall off the edge. -->
        <LinearLayout
            android:id="@+id/edit_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp" />

        <!-- The common cases, one tap each. -->
        <LinearLayout
            android:id="@+id/edit_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/edit_repeat_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rings once, at the next 07:00"
            android:textColor="@color/secondary_accent"
            android:textSize="13sp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TO SILENCE IT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/edit_kind_hard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_outline"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Scale"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/edit_kind_soft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_outline"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="A button"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/edit_kind_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only stops once you stand on the scale. Applies at home."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
