<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tab_settings"
            style="@style/TabLabel"
            android:text="Settings" />

        <TextView
            android:id="@+id/tab_alarms"
            style="@style/TabLabel"
            android:text="Alarms" />

        <TextView
            android:id="@+id/tab_weight"
            style="@style/TabLabel"
            android:text="Weight" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/ws_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● PC: disconnected"
        android:textSize="12sp"
        android:textColor="@color/ws_disconnected"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@color/bg_dark" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/settings_pane" />

        <include layout="@layout/weight_pane" />

        <LinearLayout
            android:id="@+id/alarms_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/bg_dark">

            <TextView
                android:id="@+id/alarms_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No alarms yet"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:gravity="center"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/alarms_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/alarms_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <Button
                android:id="@+id/alarms_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+  Add alarm"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/secondary_accent"
                android:textColor="@color/bg_dark"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/alarms_last_sync"
                style="@style/SettingsCaption"
                android:text=""
                android:gravity="center" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
