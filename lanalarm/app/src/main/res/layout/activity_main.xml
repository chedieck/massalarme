<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Massalarmee"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/secondary_accent"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/service_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service: Unknown"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/service_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toggle Service"
        android:backgroundTint="@color/primary_accent"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/secret_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secret: Not set"
        android:textSize="16sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/scan_secret"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan QR Secret"
        android:backgroundTint="@color/primary_accent"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="24dp" />

    <Switch
        android:id="@+id/boot_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start on boot"
        android:textSize="16sp"
        android:textColor="@color/text_primary" />

</LinearLayout>
