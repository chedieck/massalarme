<?xml version="1.0" encoding="utf-8"?>
<!--
  Tabs live at the bottom, within thumb reach: switching panes was a stretch to
  the top of a tall screen. Icons rather than words — three destinations do not
  need labels once the shapes are learned.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/settings_pane" />

        <include layout="@layout/weight_pane" />

        <LinearLayout
            android:id="@+id/alarms_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/bg_dark">

            <TextView
                android:id="@+id/alarms_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No alarms yet"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:gravity="center"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/alarms_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/alarms_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <Button
                android:id="@+id/alarms_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+  Add alarm"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/secondary_accent"
                android:textColor="@color/bg_dark"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/alarms_last_sync"
                style="@style/SettingsCaption"
                android:text=""
                android:gravity="center" />
        </LinearLayout>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_dark"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/tab_settings"
            style="@style/TabIcon"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />

        <ImageView
            android:id="@+id/tab_alarms"
            style="@style/TabIcon"
            android:src="@drawable/ic_alarm"
            android:contentDescription="Alarms" />

        <ImageView
            android:id="@+id/tab_weight"
            style="@style/TabIcon"
            android:src="@drawable/ic_weight"
            android:contentDescription="Weight" />
    </LinearLayout>

</LinearLayout>
